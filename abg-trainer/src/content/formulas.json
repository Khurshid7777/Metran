        "source": "Kassirer & Bleich 1965"
      },
      {
        "nameKey": "ref.winters",
        "formula": "pCO₂ = 1.5 × HCO₃⁻ + 8 ± 2",
        "source": "Winters 1967"
      },
      {
        "nameKey": "ref.metAlk",
        "formula": "pCO₂ = 0.7 × HCO₃⁻ + 21 ± 2 (≤ 55)",
        "source": "Javaheri 1982"
      },
      {
        "nameKey": "ref.respAcid",
        "formula": "HCO₃⁻ = 24 + 0.1 × (pCO₂ − 40) acute; 24 + 0.35 × (pCO₂ − 40) chronic",
        "source": "Narins & Emmett 1980"
      },
      {
        "nameKey": "ref.respAlk",
        "formula": "HCO₃⁻ = 24 − 0.2 × (40 − pCO₂) acute; 24 − 0.4 × (40 − pCO₂) chronic",
        "source": "Narins & Emmett 1980"
      },
      {
        "nameKey": "metric.pHacute",
        "formula": "pH = 7.4 + 0.008 × (40 − pCO₂) acute; 7.4 + 0.003 × (40 − pCO₂) chronic",
        "source": "Berend 2018"
      },
      {
        "nameKey": "metric.sbeVanSlyke",
        "formula": "SBE = 0.93 × (HCO₃⁻ − 24.4 + 14.83 × (pH − 7.4))",
        "source": "Siggaard-Andersen; CLSI C46"
      },
      {
        "nameKey": "ref.copenhagen",
        "formula": "ΔpCO₂ = SBE (met. acidosis); ΔpCO₂ = 0.6 × SBE (met. alkalosis); SBE = 0.4 × ΔpCO₂ (chronic resp.)",
        "source": "Schlichtig 1998"
      }
    ]
  },
  {
    "group": "anionGap",
